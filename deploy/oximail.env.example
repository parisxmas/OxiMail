# OxiMail environment file — see README "Configuration" for every
# variable. The settings here are the typical "real deployment"
# starting point: ACME on, SRS on, MTA-STS published.

# --- identity ---
OXIMAIL_HOSTNAME=mail.example.com

# --- OxiDB backend ---
OXIMAIL_OXIDB_HOST=127.0.0.1
OXIMAIL_OXIDB_PORT=4444

# --- listeners (left at IANA defaults) ---
# OXIMAIL_SMTP_ADDR=:25
# OXIMAIL_SMTPS_ADDR=:465
# OXIMAIL_SUBMISSION_ADDR=:587
# OXIMAIL_IMAP_ADDR=:143
# OXIMAIL_IMAPS_ADDR=:993
# OXIMAIL_WEBMAIL_ADDR=:8080
# OXIMAIL_METRICS_ADDR=:9090

# --- TLS via ACME / Let's Encrypt ---
# Comment OXIMAIL_ACME_HOSTS out and uncomment the static-cert pair
# below to use your own PEM files instead.
OXIMAIL_ACME_HOSTS=mail.example.com,mta-sts.example.com
OXIMAIL_ACME_CACHE=/var/lib/oximail/acme-cache
OXIMAIL_ACME_EMAIL=ops@example.com
OXIMAIL_ACME_CHALLENGE_ADDR=:80
# OXIMAIL_ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory

# Static-cert alternative (SIGHUP reloads):
# OXIMAIL_TLS_CERT=/etc/oximail/tls.crt
# OXIMAIL_TLS_KEY=/etc/oximail/tls.key

# --- webmail SPA ---
OXIMAIL_WEBMAIL_STATIC=/var/lib/oximail/web

# --- SRS (alias forwarding to remote addresses) ---
# Generate once and keep stable: openssl rand -hex 32
# OXIMAIL_SRS_SECRET=replace-me-with-32-hex-bytes

# --- MTA-STS (publish a strict-TLS policy for inbound mail) ---
OXIMAIL_MTASTS_MODE=enforce
OXIMAIL_MTASTS_MX=mail.example.com
OXIMAIL_MTASTS_MAX_AGE=86400

# --- spam (Rspamd integration is optional) ---
# OXIMAIL_RSPAMD_URL=http://127.0.0.1:11333

# --- logging ---
OXIMAIL_LOG_FORMAT=json
OXIMAIL_LOG_LEVEL=info
