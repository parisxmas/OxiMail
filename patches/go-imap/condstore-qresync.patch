+				dummyUID imap.UIDSet
+			)
+			if !dec.ExpectNumSet(imapwire.NumKindSeq, &dummySeq) ||
+				!dec.ExpectSP() || !dec.ExpectUIDSet(&dummyUID) || !dec.ExpectSpecial(')') {
+				return nil, dec.Err()
+			}
+		} else {
+			if !dec.ExpectUIDSet(&q.KnownUIDs) {
+				return nil, dec.Err()
+			}
+		}
+	}
+	if !dec.ExpectSpecial(')') {
+		return nil, dec.Err()
+	}
+	return q, nil
+}
