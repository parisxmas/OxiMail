+// readFetchModifiers parses the optional parenthesised modifier list
+// that follows a FETCH item list, per RFC 7162 §3.2. Currently
+// supported: CHANGEDSINCE (CONDSTORE). VANISHED (QRESYNC) is rejected
+// here so a client mistakenly using it does not silently succeed.
+func readFetchModifiers(dec *imapwire.Decoder, options *imap.FetchOptions) error {
+	return dec.ExpectList(func() error {
+		var name string
+		if !dec.ExpectAtom(&name) {
+			return dec.Err()
+		}
+		switch strings.ToUpper(name) {
+		case "CHANGEDSINCE":
+			if !dec.ExpectSP() || !dec.ExpectModSeq(&options.ChangedSince) {
+				return dec.Err()
+			}
+		default:
+			return newClientBugError("unknown FETCH modifier")
+		}
+		return nil
+	})
+}
